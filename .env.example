APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=asset_management_system
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# GOOGLE GEMINI API
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Model cadangan (dipisah koma) saat model utama 503/high demand.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite
GEMINI_OCR_PROMPT=Baca dan ekstrak seluruh teks dari dokumen ini secara akurat. Pertahankan format asli dokumen.
GEMINI_MAX_TOKENS=1024

# Gemini API Optimization
GEMINI_IMAGE_MAX_WIDTH=1024
GEMINI_IMAGE_QUALITY=85
GEMINI_REQUEST_DELAY_MS=100
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_MS=1000
GEMINI_BATCH_SIZE=5
GEMINI_BATCH_DELAY_MS=500
# Jumlah halaman PDF yang dikirim ke Gemini untuk OCR (0 = semua halaman).
# Halaman lain tetap diarsipkan utuh; hanya input OCR yang dipotong.
GEMINI_PDF_OCR_PAGES=1
# Resolusi media: low | medium | high | unspecified.
# low = paling hemat token; naikkan ke medium bila akurasi OCR turun.
GEMINI_MEDIA_RESOLUTION=low
# Thinking Gemini 3/4: minimal | low | medium | high. minimal = paling hemat.
GEMINI_THINKING_LEVEL=minimal
# Untuk Gemini 2.5: 0 = thinking mati, -1 = dinamis.
# GEMINI_THINKING_BUDGET=0
# Paksa output JSON tanpa markdown.
GEMINI_RESPONSE_MIME_TYPE=application/json

# SCANNER FTP SERVER
SCANNER_FTP_HOST=127.0.0.1
SCANNER_FTP_PORT=21
SCANNER_FTP_USERNAME=
SCANNER_FTP_PASSWORD=
# Umur minimal file (detik) sebelum diproses agar tidak membaca file yang masih diunggah scanner.
SCANNER_MIN_FILE_AGE=15
# Pecah PDF menjadi gambar per halaman (perilaku lama). Default false = PDF utuh disimpan.
SCANNER_SPLIT_PDF_PAGES=false
